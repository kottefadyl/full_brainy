rules_version = '2';
// Brainy real-time signals (api/src/realtime). Only the API writes (Admin SDK, rules do not apply to it).
// A signed-in person reads a signal only when listed among its readers: the collection owner and its members.
service cloud.firestore {
  match /databases/{database}/documents {
    match /brainy_signals/{collectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.readers;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
